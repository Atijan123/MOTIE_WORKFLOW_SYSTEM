# Copy to .env and change every password. .env is git-ignored; never commit it.
# Use letters and digits in passwords: @ : / would break the database URLs.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(24))"

# The Postgres superuser. Only db/init/10-db-users.sh and the test setup log in
# with it; the API and migrations never do.
POSTGRES_USER=motie
POSTGRES_PASSWORD=change-me
POSTGRES_DB=motie

# motie_owner owns the tables. Migrations (the "tools" container) log in with it.
MIGRATION_DB_PASSWORD=change-me-too
# motie_app is what the API logs in as. It can't alter tables or the audit trigger.
APP_DB_PASSWORD=change-me-three

# Signs login tokens. Anyone who knows it can forge a login, so generate a long
# random one per server:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Tools that delete or invent data (scripts/reset-dev.sh, app/dev_seed.py) only
# run when this is "development". Set that on your own machine only; leave it
# "production" anywhere real data lives.
APP_ENV=production

# The Ministry's registry file reference, printed at the top of each facility
# letter, e.g. ADM 151/420/01/PART IV ({year} and {case_id} may be used).
# Required when APP_ENV=production: until it's set, the PS can't sign (the
# Sign button says why). With APP_ENV=development, that example is the default.
FACILITY_LETTER_REFERENCE_FORMAT=

# Where people open the site. Links in emails (e.g. "set your password" for
# walk-in applicants) start with it. On the Ministry server: its https address.
PUBLIC_BASE_URL=http://localhost:3000
# How long a "set your password" link works, in hours.
PASSWORD_LINK_HOURS=72
