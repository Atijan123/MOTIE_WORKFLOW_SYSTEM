# Copy to .env and change the password. .env is git-ignored; never commit it.
# Use letters and digits in the password: @ : / would break the DATABASE_URL.
POSTGRES_USER=motie
POSTGRES_PASSWORD=change-me
POSTGRES_DB=motie

# Signs login tokens. Anyone who knows it can forge a login, so generate a long
# random one per server:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
