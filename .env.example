# Copy to .env and change every password. .env is git-ignored; never commit it.
# Use letters and digits in passwords: @ : / would break the database URLs.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(24))"

# The Postgres superuser. Only db/init/10-db-users.sh and the test setup log in
# with it; the API and migrations never do.
POSTGRES_USER=motie
POSTGRES_PASSWORD=change-me
POSTGRES_DB=motie

# motie_owner owns the tables. Migrations (the "tools" container) log in with it.
MIGRATION_DB_PASSWORD=change-me-too
# motie_app is what the API logs in as. It can't alter tables or the audit trigger.
APP_DB_PASSWORD=change-me-three

# Signs login tokens. Anyone who knows it can forge a login, so generate a long
# random one per server:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Tools that delete or invent data (scripts/reset-dev.sh, app/dev_seed.py) only
# run when this is "development". Set that on your own machine only; leave it
# "production" anywhere real data lives. On the Ministry's office server it is
# "office" (step 13, docs/OFFICE-SETUP.md): no applicant portal, no emails to
# applicants, staff only from OFFICE_NETWORK.
APP_ENV=production

# Office mode only: the office network's address range, e.g. 192.168.10.0/24.
# Staff may sign in from here (unless STAFF_IP_ALLOWLIST says otherwise).
# Required when APP_ENV=office: the API won't start without it. [CONFIRM]
OFFICE_NETWORK=
# Emails to staff: off unless the office has a mail server.
STAFF_EMAILS_ENABLED=false

# The Ministry's registry file reference, printed at the top of each facility
# letter, e.g. ADM 151/420/01/PART IV ({year} and {case_id} may be used).
# Required when APP_ENV=production: until it's set, the PS can't sign (the
# Sign button says why). With APP_ENV=development, that example is the default.
FACILITY_LETTER_REFERENCE_FORMAT=

# Where people open the site. Links in emails (e.g. "set your password" for
# walk-in applicants) start with it. On the Ministry server: its https address.
PUBLIC_BASE_URL=http://localhost:3001
# How long a "set your password" link works, in hours.
PASSWORD_LINK_HOURS=72

# The two front ends (step 12b). Each one's server proves to the API which it
# is with its own key; generate each with secrets.token_urlsafe(48). Leave them
# out on a development machine: docker-compose.yml then uses "dev-" keys, which
# the API accepts only with APP_ENV=development.
STAFF_PORTAL_KEY=
APPLICANT_PORTAL_KEY=
# The domains each is served on, comma-separated. Staff requests whose browser
# address isn't a staff domain are refused. Empty = not checked (development).
STAFF_PORTAL_HOSTS=
APPLICANT_PORTAL_HOSTS=

# The networks staff may work from (step 12c): addresses or ranges,
# comma-separated, e.g. the office LAN and the VPN: 10.20.0.0/16, 196.46.1.7
# The check is on unless APP_ENV=development; on with an empty list, no staff
# can sign in. STAFF_IP_ALLOWLIST_ENABLED (true or false) overrides the default.
STAFF_IP_ALLOWLIST=
STAFF_IP_ALLOWLIST_ENABLED=

# Encrypts each staff member's authenticator secret in the database (step 12e).
# Generate with secrets.token_urlsafe(48). Keep it safe and never change it:
# a new key means every staff member must set up their authenticator again.
# Leave it out on a development machine (docker-compose.yml's "dev-" default).
MFA_SECRET_KEY=

# Optional (the defaults are shown). [CONFIRM] each with the Ministry.
# Staff are signed out after STAFF_IDLE_MINUTES without doing anything, and
# STAFF_SESSION_HOURS after signing in (step 12f). Signing a letter or
# approving an application asks for the password again after REAUTH_MINUTES.
# STAFF_IDLE_MINUTES=30
# STAFF_SESSION_HOURS=8
# REAUTH_MINUTES=10
# An account locks after LOCKOUT_FAILURES wrong tries in LOCKOUT_MINUTES (12d).
# LOCKOUT_FAILURES=5
# LOCKOUT_MINUTES=15
