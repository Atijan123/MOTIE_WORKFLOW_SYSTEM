# The office server's settings (step 13). Copy to .env next to
# docker-compose.office.yml and fill in EVERY value; docs/OFFICE-SETUP.md
# explains each. .env holds the keys to everything: only root may read it
# (chmod 600 .env). Never commit it, email it or put it on the backup drive.
#
# Make each secret with:   openssl rand -hex 32
# (letters and digits only: @ : / would break the database addresses)

# --- The server on the network ---
# The name staff type in the browser, e.g. etls.office. The router's DNS (or
# each PC's hosts file) must point it at this server.
OFFICE_HOSTNAME=etls.office
# This server's address on the office network: Caddy listens only there.
OFFICE_BIND_IP=192.168.10.5
# The office network's range: staff may sign in only from here. [CONFIRM]
OFFICE_NETWORK=192.168.10.0/24
# Optional: more ranges staff may use (e.g. a VPN), comma-separated. Leave
# empty to allow OFFICE_NETWORK only.
STAFF_IP_ALLOWLIST=

# --- The database ---
POSTGRES_USER=motie
POSTGRES_PASSWORD=
POSTGRES_DB=motie
MIGRATION_DB_PASSWORD=
APP_DB_PASSWORD=

# --- Keys (each one different, each `openssl rand -hex 32`) ---
JWT_SECRET=
# Encrypts the staff authenticator secrets. Keep a copy somewhere safe and
# separate from the backups: without it, every staff member must set up two-
# step sign-in again after a restore.
MFA_SECRET_KEY=
STAFF_PORTAL_KEY=

# --- The Ministry's letters ---
# The registry file reference printed on each letter. Signing is blocked until
# it's set. [CONFIRM] with the Registry.
FACILITY_LETTER_REFERENCE_FORMAT=

# --- Backups (step 13d) ---
# Where the USB backup drive is mounted. The drive must hold the empty file
# .motie-backup-drive, or backups refuse to run (so an unplugged drive can't
# make them fill the server's own disk).
BACKUP_PATH=/mnt/motie-backup
# The folder holding offsite.pub, the off-site PUBLIC key (age). Its private
# key is kept away from the server. Empty folder = no weekly encrypted archive.
OFFSITE_KEY_DIR=./office/keys

# --- Email ---
# Applicants never get emails in office mode. Staff emails: off unless the
# office has a mail server.
STAFF_EMAILS_ENABLED=false

# The version being run (scripts/office-update.sh sets it).
MOTIE_VERSION=local
